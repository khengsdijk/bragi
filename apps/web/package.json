{
  "name": "@bragi/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run build --filter=@bragi/web^... --output-logs=errors-only && vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:e2e-driver": "vite build --config e2e/selftest.vite.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:flow": "BRAGI_E2E_STACK=1 playwright test upload-flow history-flow inspector-flow section-flow audition-flow brush-flow reopen-play planner-flow extend-flow fill-flow transition-flow planner-generate-flow --project=chromium-dev"
  },
  "dependencies": {
    "@bragi/app": "workspace:*",
    "@bragi/design": "workspace:*",
    "@bragi/platform": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
