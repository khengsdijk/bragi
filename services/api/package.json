{
  "name": "@bragi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start:http": "node dist/server.js",
    "start:orchestrator": "node dist/orchestrator.js",
    "migrate": "node dist/db/migrate-cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@bragi/model-wasm": "workspace:*",
    "@bragi/schemas": "workspace:*",
    "@fastify/websocket": "^11.3.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "better-auth": "^1.7.10",
    "fastify": "^5.12.7",
    "nats": "^2.29.3",
    "nodemailer": "^10.1.6",
    "pg": "^8.23.1",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "ws": "^8.18.0",
    "@types/ws": "^8.18.0"
  }
}
