  {"op":"automation.set","scope":{"kind":"lane","sectionId":"sec_1","trackId":"trk_1"},"target":"fx:fx_1/cutoffHz","points":[{"tick":0,"value":18000,"curve":"linear"},{"tick":15360,"value":900,"curve":"linear"}]}"
