{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsconfig.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json",
        "**/*.css",
        "tokens.json",
        "snapshots/**",
        ".storybook/**",
        "vitest.config.ts"
      ],
      "outputs": ["coverage/**"]
    }
  }
}
