{
  "name": "@bragi/design",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.json": "./tokens.json",
    "./tokens.css": "./tokens.css",
    "./fonts.css": "./fonts.css",
    "./base.css": "./base.css"
  },
  "scripts": {
    "build": "tsc -b && node scripts/copy-css.mjs",
    "test": "vitest run && pnpm test:stories",
    "test:unit": "vitest run",
    "test:stories": "storybook build --quiet --output-dir storybook-static && node scripts/axe-stories.mjs",
    "tokens:gen": "tsc -b && node scripts/gen-tokens.mjs",
    "tokens:report": "tsc -b && node scripts/gen-tokens.mjs --report",
    "storybook": "storybook dev --port 6006"
  },
  "dependencies": {
    "radix-ui": "^1.8.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "^10.6.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
