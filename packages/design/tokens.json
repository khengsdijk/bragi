{
  "$comment": "Hand-edited source of truth for Bragi's visual language (WP-0.6, specs/11-ux-and-accessibility.md §3). tokens.css and snapshots/cvd/* are generated from this file; the contrast and distinguishability budgets at the bottom are asserted by src/tokens/__tests__/contrast.test.ts and cvd.test.ts. Colours are authored in OKLCH and committed as hex; run `pnpm --filter @bragi/design tokens:report` to print every pairing, every ΔE00 minimum and the palette back as OKLCH.",
  "font": {
    "sans": "Geist",
    "mono": "Geist Mono",
    "fallbackSans": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
    "fallbackMono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "type": {
    "baseRem": 0.875,
    "ratio": 1.2,
    "steps": {
      "xs": -1,
      "base": 0,
      "lg": 1,
      "xl": 2,
      "2xl": 3
    },
    "leading": {
      "tight": 1.25,
      "normal": 1.5
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    }
  },
  "space": {
    "unitPx": 4,
    "steps": {
      "0": 0,
      "1": 1,
      "2": 2,
      "3": 3,
      "4": 4,
      "6": 6,
      "8": 8,
      "12": 12
    }
  },
  "radius": {
    "steps": {
      "sm": 4,
      "md": 6,
      "lg": 10,
      "xl": 14,
      "full": "9999px"
    }
  },
  "size": {
    "hitTargetPx": 24,
    "controlSmPx": 24,
    "controlMdPx": 32,
    "controlLgPx": 40
  },
  "motion": {
    "fastMs": 150,
    "baseMs": 200,
    "slowMs": 250,
    "lensMs": 600,
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "emphasized": "cubic-bezier(0.3, 0, 0, 1.06)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
