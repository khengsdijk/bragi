    "decorative": [
      {
        "token": "--color-line",
        "bg": "--color-surface",
        "min": 1.2,
        "reason": "hairline separator between panels, not a control boundary"
      },
      {
        "token": "--color-line",
        "bg": "--color-canvas",
        "min": 1.2,
        "reason": "hairline separator on the canvas"
      },
      {
        "token": "--color-overlay",
        "bg": "--color-canvas",
        "min": 1.02,
        "reason": "modal scrim: it must darken what it covers. On the dark canvas the largest ratio any scrim can reach is 1.04, so the bar is what the physics allows and the dialog separates by elevation, border and shadow"
      },
      {
        "token": "--color-text-disabled",
        "bg": "--color-surface",
