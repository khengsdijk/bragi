{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FxCatalog",
  "description": "The DSP catalogue (03 §6): one source shared by the UI (control ranges), the planner (allowed params) and bragi-model::validate. The instance is crates/bragi-dsp/fx_catalog.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fx"],
  "properties": {
    "$comment": {
      "description": "Free-form provenance note carried by the source file.",
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "fx": {
      "$ref": "#/$defs/CatalogFxMap"
    }
  },
  "$defs": {
    "CatalogFxMap": {
      "description": "Every effect by FxType.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/CatalogFxDefinition" }
    },
    "CatalogFxDefinition": {
      "description": "One effect's parameters.",
      "type": "object",
      "additionalProperties": false,
      "required": ["params"],
      "properties": {
        "system": {
          "description": "Generated by the system, not offered in the expert drawer.",
          "type": "boolean"
        },
        "masterOnly": {
          "description": "Allowed only on the master chain.",
          "type": "boolean"
        },
        "params": {
          "$ref": "#/$defs/CatalogFxParams"
        }
      }
    },
    "CatalogFxParams": {
      "description": "Parameter specs by name.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/CatalogParamSpec" }
    },
    "CatalogParamSpec": {
      "description": "A parameter's kind and, for numeric params, its range and default.",
      "oneOf": [
        { "$ref": "#/$defs/CatalogNumberParam" },
        { "$ref": "#/$defs/CatalogTrackIdParam" },
        { "$ref": "#/$defs/CatalogNumberListParam" }
      ]
    },
    "CatalogNumberParam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "min", "max", "default"],
      "properties": {
        "type": { "type": "string", "enum": ["number"] },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "default": { "type": "number" }
      }
    },
    "CatalogTrackIdParam": {
      "description": "A routing target (sidechain_duck.sourceTrack), not a value in FxParams.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["trackId"] }
      }
    },
    "CatalogNumberListParam": {
      "description": "A multi-band list (match_eq.bands), not representable in FxParams.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["number[]"] }
      }
    }
  }
}
