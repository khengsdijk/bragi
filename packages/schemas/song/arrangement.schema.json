{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arrangement",
  "description": "Timebase, the ordered sections and the master bus (02 §3.5). Absolute section positions are derived, never stored.",
  "type": "object",
  "additionalProperties": false,
  "required": ["timebase", "sections", "master"],
  "properties": {
    "timebase": { "$ref": "#/$defs/Timebase" },
    "sections": {
      "description": "ORDERED. The absolute start tick of section i is the sum of lengthTicks of sections[0..i).",
      "type": "array",
      "items": { "$ref": "section.schema.json" }
    },
    "master": { "$ref": "#/$defs/Master" }
  },
  "$defs": {
    "Timebase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ppq", "tempoMap", "timeSignatures"],
      "properties": {
        "ppq": {
          "description": "Pulses per quarter note. Fixed at 960 (02 §2.2).",
          "type": "integer",
          "enum": [960]
        },
        "tempoMap": { "$ref": "#/$defs/TempoMap" },
        "timeSignatures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/TimeSig" }
        }
      }
    },
    "TempoMap": {
      "description": "Sorted by tick, first entry at tick 0 (02 §2.2, invariant 4.3.4).",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/TempoPoint" }
    },
    "TempoPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tick", "bpm", "curve"],
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "bpm": { "type": "number", "minimum": 20, "maximum": 400 },
        "curve": { "$ref": "#/$defs/TempoCurve" }
      }
    },
    "TempoCurve": {
      "description": "How tempo moves from this point to the next.",
      "type": "string",
      "enum": ["step", "linear"]
    },
    "TimeSig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bar", "numerator", "denominator"],
      "properties": {
        "bar": { "description": "Zero-based bar index.", "type": "integer", "minimum": 0 },
        "numerator": { "type": "integer", "minimum": 1, "maximum": 64 },
        "denominator": { "type": "integer", "enum": [1, 2, 4, 8, 16, 32] }
      }
    },
    "Master": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fx", "automation", "gainDb"],
      "properties": {
        "fx": { "$ref": "fx.schema.json#/$defs/FxChain" },
        "automation": {
          "description": "Master automation uses ABSOLUTE arrangement ticks (02 §3.7, §5.3).",
          "$ref": "automation.schema.json#/$defs/AutomationList"
        },
        "gainDb": { "type": "number" }
      }
    }
  }
}
