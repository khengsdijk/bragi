{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalysisRef",
  "description": "What the document knows about one source's analysis: stage statuses, refs to the result blobs and the projection of those results the arrangement is built from (02 §3.3, §6). The blobs' full shapes are in packages/schemas/analysis/.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "status", "blobs"],
  "properties": {
    "profile": { "$ref": "common.schema.json#/$defs/AnalysisProfile" },
    "status": { "$ref": "#/$defs/AnalysisStatusMap" },
    "blobs": { "$ref": "#/$defs/AnalysisBlobMap" },
    "effects": {
      "description": "The effects `analysis.apply` has recorded, merged by kind. `bragi-model` rebuilds the analysis-owned arrangement from this list, which is why the document does not need to read the blobs (02 §6, Q12).",
      "$ref": "#/$defs/AnalysisEffectList"
    },
    "stems": { "$ref": "#/$defs/StemAssetMap" },
    "summary": { "$ref": "#/$defs/AnalysisSummary" }
  },
  "$defs": {
    "AnalysisStageStatus": {
      "type": "string",
      "enum": ["pending", "running", "done", "failed"]
    },
    "AnalysisStatusMap": {
      "description": "Status per stage. Stages not yet requested are absent.",
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/AnalysisStage" },
      "additionalProperties": { "$ref": "#/$defs/AnalysisStageStatus" }
    },
    "AnalysisBlobMap": {
      "description": "Result blob per finished stage, e.g. rhythm → sha256:….",
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/AnalysisStage" },
      "additionalProperties": { "$ref": "common.schema.json#/$defs/AssetHash" }
    },
    "StemAssetMap": {
      "description": "Separated stems (working assets) by role.",
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/StemRole" },
      "additionalProperties": { "$ref": "common.schema.json#/$defs/AssetHash" }
    },
    "AnalysisSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bpm", "key", "durationSec", "genres", "moods"],
      "properties": {
        "bpm": { "type": "number", "exclusiveMinimum": 0 },
        "key": { "description": "Human-readable key, e.g. \"F# minor\".", "type": "string" },
        "durationSec": { "type": "number", "minimum": 0 },
        "genres": { "$ref": "common.schema.json#/$defs/TagList" },
        "moods": { "$ref": "common.schema.json#/$defs/TagList" }
      }
    },
    "AnalysisEffectList": {
      "description": "The recorded effects, one per kind, in a fixed kind order (tempo, sections, separation, tags, description, key) so the list is a set rather than an arrival log (02 §6).",
      "type": "array",
      "items": { "$ref": "#/$defs/AnalysisEffect" }
    },
    "AnalysisEffect": {
      "description": "One analysed fact the arrangement is built from. Each kind is owned by exactly one stage (02 §6).",
      "oneOf": [
        { "$ref": "#/$defs/TempoEffect" },
        { "$ref": "#/$defs/SectionsEffect" },
        { "$ref": "#/$defs/SeparationEffect" },
        { "$ref": "#/$defs/TagsEffect" },
        { "$ref": "#/$defs/DescriptionEffect" },
        { "$ref": "#/$defs/KeyEffect" }
      ]
    },
    "TempoEffect": {
      "description": "`rhythm`: the beat grid as a tempo map and time signatures (02 §6).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tempoMap", "timeSignatures"],
      "properties": {
        "kind": { "type": "string", "enum": ["tempo"] },
        "tempoMap": { "$ref": "arrangement.schema.json#/$defs/TempoMap" },
        "timeSignatures": { "$ref": "arrangement.schema.json#/$defs/TimeSignatureList" }
      }
    },
    "SectionsEffect": {
      "description": "`structure`: the analysed section boundaries and labels, exactly as the structure blob reports them (04 §5.2).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sections"],
      "properties": {
        "kind": { "type": "string", "enum": ["sections"] },
        "sections": { "$ref": "../analysis/structure.schema.json#/$defs/StructureSectionList" }
      }
    },
    "SeparationEffect": {
      "description": "`separation`: one working asset per stem plus the residual (04 §4, 02 §3.4).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "stems", "residual"],
      "properties": {
        "kind": { "type": "string", "enum": ["separation"] },
        "stems": { "$ref": "../analysis/separation.schema.json#/$defs/StemAssetList" },
        "residual": { "$ref": "common.schema.json#/$defs/AssetHash" }
      }
    },
    "TagsEffect": {
      "description": "`tag`: the labels to merge into `meta.tags`, split the way the taxonomy reports them (04 §6.2). Scores stay in the blob.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "genres", "moods"],
      "properties": {
        "kind": { "type": "string", "enum": ["tags"] },
        "genres": { "$ref": "common.schema.json#/$defs/TagList" },
        "moods": { "$ref": "common.schema.json#/$defs/TagList" }
      }
    },
    "DescriptionEffect": {
      "description": "`describe`: the plain-language description for `meta.description` (04 §6.3).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description"],
      "properties": {
        "kind": { "type": "string", "enum": ["description"] },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "KeyEffect": {
      "description": "`harmony`: the analysed key, projected from the harmony blob's `key { tonic, mode, confidence }` (04 §5.3). The confidence stays in the blob; the arrangement does not change.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tonic", "mode"],
      "properties": {
        "kind": { "type": "string", "enum": ["key"] },
        "tonic": {
          "description": "Note name, e.g. \"F#\".",
          "type": "string",
          "minLength": 1
        },
        "mode": { "$ref": "../analysis/common.schema.json#/$defs/KeyMode" }
      }
    }
  }
}
