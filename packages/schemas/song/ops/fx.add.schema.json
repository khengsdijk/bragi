{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FxAddOp",
  "description": "`fx.add` (02 §4.2). Insert an effect into a track, clip or master chain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "op",
    "scope",
    "fx"
  ],
  "properties": {
    "op": {
      "type": "string",
      "enum": [
        "fx.add"
      ]
    },
    "scope": {
      "$ref": "#/$defs/FxScope"
    },
    "fx": {
      "$ref": "../fx.schema.json"
    },
    "index": {
      "description": "Position in the chain; appended when absent.",
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "FxScope": {
      "oneOf": [
        {
          "$ref": "#/$defs/TrackFxScope"
        },
        {
          "$ref": "#/$defs/ClipFxScope"
        },
        {
          "$ref": "#/$defs/MasterFxScope"
        }
      ]
    },
    "TrackFxScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "trackId"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "track"
          ]
        },
        "trackId": {
          "$ref": "../common.schema.json#/$defs/TrackId"
        }
      }
    },
    "ClipFxScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "clipId"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "clip"
          ]
        },
        "clipId": {
          "$ref": "../common.schema.json#/$defs/ClipId"
        }
      }
    },
    "MasterFxScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "master"
          ]
        }
      }
    }
  }
}
