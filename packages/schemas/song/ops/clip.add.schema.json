{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClipAddOp",
  "description": "`clip.add` (02 §4.2). Add a clip to a section's lane for a track.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "op",
    "sectionId",
    "trackId",
    "clip"
  ],
  "properties": {
    "op": {
      "type": "string",
      "enum": [
        "clip.add"
      ]
    },
    "sectionId": {
      "$ref": "../common.schema.json#/$defs/SectionId"
    },
    "trackId": {
      "$ref": "../common.schema.json#/$defs/TrackId"
    },
    "clip": {
      "$ref": "../clip.schema.json"
    }
  }
}
