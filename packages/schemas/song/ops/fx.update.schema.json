{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FxUpdateOp",
  "description": "`fx.update` (02 §4.2). Patch an effect's parameters and/or bypass.",
  "type": "object",
  "additionalProperties": false,
  "required": ["op", "fxId", "paramsPatch"],
  "properties": {
    "op": {
      "type": "string",
      "enum": ["fx.update"]
    },
    "fxId": {
      "$ref": "../common.schema.json#/$defs/FxId"
    },
    "paramsPatch": {
      "$ref": "../fx.schema.json#/$defs/FxParams"
    },
    "bypass": {
      "type": "boolean"
    },
    "sidechainSource": {
      "$ref": "#/$defs/SidechainSourcePatch",
      "description": "The key track for `sidechain_duck` (03 §6 `sourceTrack`); `null` clears it."
    }
  },
  "$defs": {
    "SidechainSourcePatch": {
      "description": "A new sidechain source, or `null` to clear it (02 §4.2 `fx.update`).",
      "oneOf": [
        {
          "$ref": "../common.schema.json#/$defs/TrackId"
        },
        {
          "$ref": "#/$defs/Null"
        }
      ]
    },
    "Null": {
      "description": "JSON null.",
      "type": "null"
    }
  }
}
