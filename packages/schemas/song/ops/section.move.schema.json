{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SectionMoveOp",
  "description": "`section.move` (02 §4.2). Move a section; its content moves with it (02 §5.1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "op",
    "sectionId",
    "toIndex"
  ],
  "properties": {
    "op": {
      "type": "string",
      "enum": [
        "section.move"
      ]
    },
    "sectionId": {
      "$ref": "../common.schema.json#/$defs/SectionId"
    },
    "toIndex": {
      "description": "New position in arrangement.sections.",
      "type": "integer",
      "minimum": 0
    }
  }
}
