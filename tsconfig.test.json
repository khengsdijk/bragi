{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    // The browser-facing sources and their tests are part of the tree this
    // config checks (`packages/app` routes, `packages/platform` adapters), so
    // it needs the same DOM and JSX settings those packages build with.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "resolveJsonModule": true
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/.storybook/**/*",
    "packages/*/vitest.config.ts",
    "services/api/src/**/*",
    "services/api/test/**/*",
    "scripts/**/*"
  ],
  "//": "Typechecks what the per-package builds leave out: the src/__tests__ files, the component tests and the JSDoc-annotated .mjs scripts. The generated Ajv validators are not typechecked either -- they carry `@ts-nocheck`, because their chosen surface is the typed facade in packages/schemas/src/generated/validators.ts."
}
