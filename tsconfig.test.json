{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": ["packages/*/src/**/*", "services/api/src/**/*", "scripts/**/*"],
  "//": "Typechecks what the per-package builds leave out: the src/__tests__ files and the JSDoc-annotated .mjs scripts."
}
