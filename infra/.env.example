# Local development values for infra/docker-compose.yml.
#
# Copy to infra/.env to override. These are deliberately weak DEVELOPMENT
# credentials for services that are only bound to localhost. Real secrets never
# enter this repository (specs/13-agent-guide.md §1) and production
# configuration comes from the environment (specs/01-architecture.md §8).

# Postgres
POSTGRES_USER=bragi
POSTGRES_PASSWORD=bragi
POSTGRES_DB=bragi
POSTGRES_PORT=5432

# MinIO (S3)
MINIO_ROOT_USER=bragi
MINIO_ROOT_PASSWORD=bragi-dev-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=bragi-blobs

# NATS JetStream
NATS_PORT=4222
NATS_MONITORING_PORT=8222

# Mailpit (magic-link email in local dev)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# API (api-http + api-orchestrator) and the CPU worker
API_PORT=8080
AUTH_SECRET=dev-only-insecure-auth-secret-change-me
WORKER_NAME=bragi-worker

# Jaeger (local OpenTelemetry trace store)
JAEGER_OTLP_PORT=4318
JAEGER_UI_PORT=16686

# describe stage (OpenRouter, ADR-0012). Leave the key empty to make describe fail cleanly.
# Never commit a real key; put it in infra/.env (git-ignored).
OPENROUTER_API_KEY=
# BRAGI_DESCRIBE_MODEL=deepseek/deepseek-v4.1-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
