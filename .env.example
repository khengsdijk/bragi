# Local secrets and settings for `pnpm dev:backend` (and the scripts that read the environment).
#
# Copy to `.env` in the repository root (git-ignored) and fill in what you need. Values already
# exported in your shell win over this file; empty values are ignored. The docker compose stack
# reads `infra/.env` instead (see infra/.env.example); `pnpm dev:backend` reads both, this file
# first. Never commit a real key (specs/13-agent-guide.md §1).

# OpenRouter: every LLM call goes through it (ADR-0012): the describe stage, the planner (WP-2.6)
# and `pnpm bench:planner`.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# BRAGI_DESCRIBE_MODEL=deepseek/deepseek-v4.1-flash

# Separation weights for the analysis worker (default: .bragi/models when it exists).
# BRAGI_MODELS_DIR=/absolute/path/to/.bragi/models

# Single-user mode is the dev:backend default (ADR-0014).
# BRAGI_AUTH_MODE=single-user
# BRAGI_OWNER_EMAIL=owner@bragi.local
# BRAGI_OWNER_NAME=Owner
# API_PORT=8080
